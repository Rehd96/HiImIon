# TEMPLATE — assumes the app lives at /home/ion/HiImIon under a user `ion`.
#
# On the VPS the app is usually at /root/HiImIon under root, so DO NOT install
# this file directly. STEP 4 of VPS_COMMANDS.txt generates the correct unit
# from $HOME and $(whoami); use that. This copy is here for reference and for
# machines that really do match the layout below.
#
# Note the difference: the generated unit omits ProtectHome, which would stop
# SQLite from writing the database when the app lives under /root.

[Unit]
Description=labustagialla.it portfolio (Django + Gunicorn)
After=network.target

[Service]
Type=notify
User=ion
Group=ion
WorkingDirectory=/home/ion/HiImIon
EnvironmentFile=/home/ion/HiImIon/.env
ExecStart=/home/ion/HiImIon/venv/bin/gunicorn hiimion.wsgi:application \
    --bind 127.0.0.1:8010 \
    --workers 3 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

# Hardening — the app needs to write exactly two paths (db + staticfiles).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ion/HiImIon
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
