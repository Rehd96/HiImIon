[Unit]
Description=labustagialla.it portfolio (Django + Gunicorn)
After=network.target

[Service]
Type=notify
User=ion
Group=ion
WorkingDirectory=/home/ion/HiImIon
EnvironmentFile=/home/ion/HiImIon/.env
ExecStart=/home/ion/HiImIon/venv/bin/gunicorn hiimion.wsgi:application \
    --bind 127.0.0.1:8010 \
    --workers 3 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

# Hardening — the app needs to write exactly two paths (db + staticfiles).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ion/HiImIon
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
