# Copy to .env on the VPS and fill in. Never commit .env.
#
# Generate a secret key:
#   ./venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=labustagialla.it,www.labustagialla.it,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://labustagialla.it,https://www.labustagialla.it

# nginx already redirects http→https; leave false to avoid a redirect loop.
DJANGO_SSL_REDIRECT=false

# HSTS. Start at 3600 once you have confirmed /cff, /fai and /ezbk are all
# HTTPS-only, then raise toward 31536000. A browser will not forget this early.
DJANGO_HSTS_SECONDS=0

# Days of raw page views to keep. `manage.py prune_views` enforces it.
PAGEVIEW_RETENTION_DAYS=400
